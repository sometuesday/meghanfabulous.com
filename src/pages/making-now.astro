---
import Base from "../layouts/Base.astro";
import making from "../data/making-now.json";
import { site } from "../config/site";
---

<Base
  title="Making Now — Meghan Fabulous"
  description="What Meghan is making at sea: a restored Dior Saddle bag, beaded bags, one of a kind. Not for sale."
>
  <header class="page-head wrap">
    <p class="label">Now · made at sea</p>
    <h1>Making now</h1>
    <p class="prose">
      A short list, chosen by hand. Plain sailing pictures stay off this page.
      <a href={site.instagram}>Follow {site.instagramHandle}</a>.
    </p>
  </header>
  <div class="wrap grid-4">
    {
      making.items.map((item) => (
        <article class="making-card">
          <a href={item.instagram}>
            <img src={item.image} alt={item.alt} width={item.width} height={item.height} />
          </a>
          <p class="label">{item.dateLabel}</p>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          {item.behind && <p class="joy">Not for sale — made for joy.</p>}
        </article>
      ))
    }
  </div>
</Base>
